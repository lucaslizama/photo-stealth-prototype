# Godot 4+ engine files
.godot/
/android/

# Godot legacy / import cache
.import/
export.cfg

# export_presets.cfg IS committed on purpose — it is how the PC builds are
# reproducible. It is only worth ignoring once it holds signing credentials
# (keystore passwords etc.), which it does not.

# Build output
build/

# .NET / Mono build artifacts
.mono/
bin/
obj/
*.user
*.userprefs
*.suo
*.swp

# Mono-specific auto-generated files
data_*/

# Godot-MCP
# Local MCP server binary is downloaded + cached per-machine
.godot/mcp-server/
# Never commit credentials (we run in local Custom mode, but be safe)
.godot-mcp/credentials.json

# OS noise
.DS_Store
Thumbs.db
